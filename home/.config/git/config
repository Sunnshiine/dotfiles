[alias]
	nuke = "!git add --all && git stash && git stash clear"

[branch]
	sort = "-committerdate"

[column]
	ui = "auto"

[core]
	fsmonitor = true

[fetch]
	prune = true
	writeCommitGraph = true

[init]
	defaultBranch = "main"

[pull]
	rebase = true

[rebase]
	updateRefs = true

[rerere]
	enabled = true

[include]
	path = ~/.config/git/local

[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
